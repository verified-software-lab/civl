/*
  The AST is correct in that `$true` is replaced by the int `1` and `||`
  returns an int.  However the model checker has `||` return the CIVL
  bool type, and there is no conversion of it to int.
*/
int f(void) {
  return $true || $true;
}

int main(void) {
  int x = f();
  $print(x, "\n");
  $assert(x!=0);
}
