#include <complex.h>

int main(void) {
  int n = 5;
  double _Complex a[n];
  for (int i=0; i<n; i++) {
    a[i] = i + i*1.0I;
    $print(a[i], "\n");
  }
  $assert($forall (int i:0 .. n-1) a[i]+a[i] == 2*i + 2*i*1.0I);
  $assert($exists (int i:0 .. n-1) a[i] != 0);
  $assert($forall (int i:0 .. n-1) creal(a[i]) == i && cimag(a[i]) == i);
  //$assert($forall (int i:0 .. n-1) cabs(cacos(a[i])) >= 0);
}
